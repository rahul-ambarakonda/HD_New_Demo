# Application Configuration
# Defines the environment in which the application runs.
NODE_ENV=development # Application environment (e.g., development, production, test)
PORT=3000 # Port on which the application server will listen
APP_HOST=localhost # Host interface the application should bind to (e.g., 0.0.0.0 for all interfaces)
APP_BASE_URL=http://localhost:3000 # The public base URL of the application, used for absolute links or redirects

# Database Configuration
# Settings for connecting to the application's primary database.
DATABASE_URL="postgres://user:password@host:port/database_name" # Connection string for the database (e.g., PostgreSQL, MySQL)
# DATABASE_CLIENT=pg # Optional: Specify the database client if needed (e.g., pg for PostgreSQL, mysql2 for MySQL)
# DATABASE_HOST=localhost # Alternative: Database host
# DATABASE_PORT=5432 # Alternative: Database port
# DATABASE_USER=your_db_user # Alternative: Database username
# DATABASE_PASSWORD=your_db_password # Alternative: Database password
# DATABASE_NAME=your_db_name # Alternative: Database name

# Security & Authentication
# Secrets and keys for session management, JWTs, or API authentication.
SESSION_SECRET=your_session_secret_here # Secret key for signing session IDs (if using sessions)
JWT_SECRET=your_jwt_secret_here # Secret key for signing JSON Web Tokens (if using JWTs)

# Waitlist Service Configuration
# Specific settings related to the waitlist functionality in src/routes/waitlist.js.
WAITLIST_SIGNUP_ENABLED=true # Enable or disable waitlist signups
WAITLIST_EMAIL_RECIPIENT=admin@example.com # Email address to notify on new waitlist signups

# Email Service Configuration
# Settings for sending emails, potentially for waitlist confirmations or notifications.
MAIL_SENDER_EMAIL=noreply@example.com # The email address from which automated emails are sent
MAIL_HOST=smtp.example.com # SMTP host for sending emails
MAIL_PORT=587 # SMTP port (e.g., 587 for TLS, 465 for SSL)
MAIL_USER=your_email_user # Username for SMTP authentication
MAIL_PASSWORD=your_email_password # Password for SMTP authentication

# Logging Configuration
# Defines the verbosity and format of application logs.
LOG_LEVEL=info # Minimum log level to output (e.g., error, warn, info, debug, silly)

# CORS Configuration
# Cross-Origin Resource Sharing settings, if the frontend and backend are on different domains.
CORS_ORIGIN=http://localhost:3000 # Comma-separated list of allowed origins or '*' for all (e.g., http://localhost:8080)
CORS_METHODS=GET,POST,PUT,DELETE # Comma-separated list of allowed HTTP methods
CORS_HEADERS=Content-Type,Authorization # Comma-separated list of allowed HTTP headers
